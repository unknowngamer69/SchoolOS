{
  "name": "schoolos",
  "version": "1.0.0",
  "description": "a full school management system, that handles  everything your school needs.",
  "homepage": "https://github.com/mumuniazeez/schoolos#readme",
  "bugs": {
    "url": "https://github.com/mumuniazeez/schoolos/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mumuniazeez/schoolos.git"
  },
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "frontend": "pnpm --filter frontend dev",
    "backend": "pnpm --filter backend start:dev",
    "dev": "concurrently \"pnpm --filter frontend dev\" \"pnpm --filter backend start:dev\"",
    "build": "pnpm --filter frontend build && pnpm --filter server build"
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.8",
    "radix-ui": "^1.8.1"
  }
}
