// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model School {
  id String @id @default(uuid())

  name               String
  motto              String
  phoneNumber        String
  email              String @unique
  address            String
  masterPasswordHash String

  ministryAccreditationNumber String @unique

  users            User[]
  classes          Class[]
  announcements    Announcement[]
  attendances      Attendance[]
  academicSessions AcademicSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schools")
}

model User {
  id String @id @default(uuid())

  firstName    String
  lastName     String
  email        String @unique
  passwordHash String

  role UserRole

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId String
  staff    Staff?
  student  Student?
  guardian Guardian?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("users")
}

model Class {
  id String @id @default(uuid())

  class         StudentClasses
  classArm      StudentClassArm
  roomLocation  String
  classCapacity Int

  students Student[]

  assignedStaff Staff  @relation(fields: [staffId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  staffId       String

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId    String
  attendances Attendance[]
  subjects    Subject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([schoolId])
  @@map("classes")
}

model Subject {
  id String @id @default(uuid())

  code     String          @unique
  title    String
  category SubjectCategory @default(core)

  classes Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subjects")
}

model Staff {
  id String @id @default(uuid())

  role        String
  phoneNumber String

  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  classes Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staffs")
}

model Student {
  id              String @id @default(uuid())
  admissionNumber String @unique

  dateOfBirth DateTime
  gender      Gender
  bloodGroup  String
  address     String

  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  guardianId String

  class   Class  @relation(fields: [classId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  classId String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guardianId])
  @@index([classId])
  @@map("students")
}

model Guardian {
  id String @id @default(uuid())

  phoneNumber  String
  relationship GuardianRelationship

  students Student[]

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guardians")
}

model Announcement {
  id String @id @default(uuid())

  title          String
  content        String
  targetAudience AnnouncementTargetAudience @default(whole_school)
  priority       AnnouncementPriority

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("announcements")
}

model Attendance {
  id String @id @default(uuid())

  status AttendanceStatus
  note   String?

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studentId String

  class   Class  @relation(fields: [classId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  classId String

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([classId])
  @@index([schoolId])
  @@map("attendances")
}

model AcademicSession {
  id String @id @default(uuid())

  name      String
  startData DateTime
  endData   DateTime

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  schoolId String

  academicTerms AcademicTerm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("academicSessions")
}

model AcademicTerm {
  id String @id @default(uuid())

  name      String
  startData DateTime
  endData   DateTime

  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  academicSessionId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicSessionId])
  @@map("academicTerms")
}

enum UserRole {
  root_admin
  school_admin
  teacher
  parent
  student
}

enum Gender {
  male
  female
}

enum StudentClasses {
  grade_1
  grade_2
  grade_3
  grade_4
  grade_5
  grade_6
  grade_7
  grade_8
  grade_9
  grade_10
  grade_11
  grade_12

  @@map("Classes")
}

enum StudentClassArm {
  gold
  silver
  blue
  diamond
  pearl

  @@map("ClassArm")
}

enum GuardianRelationship {
  father
  mother
  uncle
  aunty
  family_member
}

enum AnnouncementTargetAudience {
  whole_school
  staff
  students
  parent
  parent_student
  parent_staff
  staff_student
}

enum AnnouncementPriority {
  normal
  high
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum SubjectCategory {
  core
  vocational
}
